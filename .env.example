# 复制为 .env 后填写（微信测试号信息从 https://mp.weixin.qq.com 沙箱页获取）
WX_APPID=
WX_SECRET=
WX_OPENID=
WX_TEMPLATE_ID=
# AI 快报独立模板（若共用国内那条模板，此处留空则 AI 流水线会失败）
WX_TEMPLATE_ID_AI=

# GitHub 仓库，例: zhangsan/news-daily（用于去重查询与本地 git 发布）
GH_REPO=
# GitHub Pages 首页（开 Pages 后填，例: https://zhangsan.github.io/news-daily，末尾不带斜杠）
PAGES_URL=
# 可选：GitHub Personal Access Token，提高去重 API 配额（本地运行可留空）
GITHUB_TOKEN=
